# Enforce consistent LF line endings across all platform
* text=auto eol=lf

# Explicitly tag configuration and automation languages
*.yml text eol=lf
*.yaml text eol=lf
*.container text eol=lf
*.volume text eol=lf
*.network text eol=lf
*.conf text eol=lf
*.sh text eol=lf
Containerfile text eol=lf
Justfile text eol=lf
